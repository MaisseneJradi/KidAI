# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# PostgreSQL 17 local (base et utilisateur créés à la main, voir README)
DATABASE_URL=postgresql+psycopg://kidai:kidai_dev@localhost:5432/kidai

# Origines autorisées à appeler l'API (frontend Vite)
CORS_ORIGINS=["http://localhost:5173"]

# Secret de signature des JWT parent :
#   backend\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Clé de chiffrement des données sensibles de l'enfant (date de naissance, besoins) :
#   backend\.venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ La perdre rend ces données illisibles.
DATA_ENCRYPTION_KEY=
