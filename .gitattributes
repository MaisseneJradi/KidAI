# Fins de ligne LF dans le dépôt ET dans les copies de travail, quel que soit core.autocrlf :
# sans cela, Git réécrit les fichiers en CRLF sous Windows et prettier refuse les commits.
* text=auto eol=lf

# Scripts Windows : CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Données : octets conservés tels quels, sinon les empreintes de dvc.lock ne correspondent plus
# après un clone et DVC relance des étapes pour rien.
data/cache/** -text
data/processed/** -text
data/annotation/*.csv -text

# RAG (manuels CNP, sous droits : le dépôt doit rester privé) : stockés avec Git LFS, l'index
# Qdrant dépassant la limite de 100 Mo par fichier de GitHub. Collaborateurs : git lfs install.
data/qdrant/** filter=lfs diff=lfs merge=lfs -text
data/processed/cnp/** filter=lfs diff=lfs merge=lfs -text

# Binaires
*.parquet binary
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary
